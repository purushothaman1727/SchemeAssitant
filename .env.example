# Copy to .env and edit. Never commit .env.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL in Docker; SQLite is used for local tests) ---
DATABASE_URL=postgresql+psycopg2://schemeuser:change-me@db:5432/schemes
POSTGRES_USER=schemeuser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=schemes

# --- Admin auth ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=60
# First admin is created by `python -m app.scripts.create_admin`
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=

# --- Privacy / retention ---
PROFILE_RETENTION_DAYS=30
CHAT_RETENTION_DAYS=30

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_CHAT=20/minute

# --- Vector store / embeddings ---
CHROMA_PATH=./data/chroma
EMBEDDING_BACKEND=fastembed   # fastembed (ONNX, no PyTorch) | hashing (offline fallback)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_CACHE_DIR=./data/models
RETRIEVAL_MIN_SCORE=0.25
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# --- LLM provider: groq | openai_compatible | ollama | none ---
# Groq: create a key at https://console.groq.com and paste it below (never commit it).
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
# Local alternative: LLM_PROVIDER=ollama, LLM_BASE_URL=http://localhost:11434, LLM_MODEL=llama3.1:8b
